# EditorConfig (https://editorconfig.org): describes what the source tree already does (UTF-8, LF, four spaces, no tabs,
# no trailing blanks, a final newline). It changes no file by itself.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Two trailing blanks are a line break in Markdown
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

# cmd.exe needs CRLF (see .gitattributes)
[*.{bat,cmd}]
end_of_line = crlf

# Generated by tools/analyze_binary.py and tools/dump_table4.py: written without a final newline
[docs/*.json]
insert_final_newline = unset

# Original game files, the generated asset catalogue, the decompilation and the vendored MP3 decoder: never reformat
[{Original-Ants/**,asset_catalog/**,docs/legacy/**,include/ants_app/dr_mp3.h}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
