# =============================================================================
# The dedicated game server (ants_server): a headless program, no SDL, no game assets except the six maps.
#   docker build -f Dockerfile.server -t ants-server .
#   docker run --rm -v ants-results:/results -p 4001:4001 -p 127.0.0.1:4002:4002 -p 127.0.0.1:4010:4010 ants-server
# The control secret: pass -e ANTS_SERVER_SECRET=<a long random secret>, or leave it out: the server makes one the first time it starts, prints it once in its log
# and keeps it in /results/control-secret (keep /results in a volume, so that the next start finds it).
# The image holds the six maps of the original game in /maps, so a server runs at once, and the players' maps in /community-maps (the lobby may choose them, GET /maps lists them; a volume at /maps does not hide them). To use other maps (the .lvl files that rooms may use), mount a folder at /maps
# (it replaces them): -v /path/to/maps:/maps:ro. The control interface (4010) and the WebSocket port (4002) are meant to be
# reached from this machine only: publish them on 127.0.0.1 and let a reverse proxy (TLS) or the lobby's backend talk to them; only the TCP game port is public.
# The replay port (--replay-port, off unless a command gives it; docker-compose.stack.yml starts the server with 4020) is the read-only list and download of the kept matches: it needs no secret, so
# do not publish it either: the site's nginx reaches it over the network of the stack, and its rate limits and its five-second cache of the list stand in front of it (docker/nginx.conf).
# The test-map door (--test-map-port, off unless a command gives it; docker-compose.stack.yml starts the server with 4031) takes the Map Maker's draft maps (POST /test-maps) and nothing else: it is not published either.
# =============================================================================
FROM debian:12-slim AS builder

# ccache makes a compile of unchanged sources a copy of the last result (CMakeLists.txt finds it by itself); its folder is a BuildKit cache mount, kept by the host between builds and never part of
# the image. The mounts (`RUN --mount=type=cache`) need BuildKit (Docker 23 and later builds with it; docs/BUILD_AND_RUN.md says how to switch it on and what the old builder says).
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential cmake ccache && \
    rm -rf /var/lib/apt/lists/*
ENV CCACHE_DIR=/root/.ccache CCACHE_MAXSIZE=1G

# The layers of this stage are ordered by how often their input changes, so that a release that changes no C++ does not compile it again: (1) the sources and the build files, which are all that the
# compile reads (ANTS_BUILD_TOOLS=OFF: CMake does not look for the programs of tools/, so that folder is not copied at all); (2) the file VERSION; (3) the build id. Only the first compiles the
# whole server. It does so with a version of 999.999.999 (a number that no release has), which the second replaces: the version is a constant in a header that CMake generates from VERSION, and the one program file that includes it
# (src/ants_server/main.cpp, besides the build id's own file) is the only one that the second layer compiles again before it links.
WORKDIR /src
COPY CMakeLists.txt ./
COPY cmake/ ./cmake/
COPY include/ ./include/
COPY src/ ./src/
COPY third_party/ ./third_party/

RUN echo 999.999.999 > VERSION
RUN --mount=type=cache,target=/root/.ccache,id=ants-ccache-server \
    ccache -z > /dev/null && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DANTS_BUILD_APP=OFF -DBUILD_TESTS=OFF -DANTS_BUILD_TOOLS=OFF && \
    cmake --build build -j"$(nproc)" --target ants_server && \
    ccache -s

# The real version (the file VERSION): CMake generates its header again (the grep stops the build if it did not) and the files that include it are compiled again.
COPY VERSION ./VERSION
RUN --mount=type=cache,target=/root/.ccache,id=ants-ccache-server \
    cmake -B build && \
    grep -q "\"v$(head -n 1 VERSION | tr -d '[:space:]')\"" build/generated/ants_app/version.hpp && \
    cmake --build build -j"$(nproc)" --target ants_server

# Which build this is (`ants_server --version` and the first line of the log say it), found AFTER the compile and after the version so that a new commit recompiles one tiny file and links again instead
# of building the server again. The first of: the build argument ANTS_BUILD_ID (docker build --build-arg ANTS_BUILD_ID=$(git rev-parse --short HEAD) -f Dockerfile.server .; a compose
# file's build.args), the commit named by the HEAD and refs files of the repository's .git folder (a stack that a deployment tool builds from a clone has them: .dockerignore lets only
# these three through, never .git/config), the UTC build time. docker/resolve_build_id.sh says which one it used in the build log. The last step runs the program and stops the build unless it says the version of
# the file VERSION as this layer copied it (not the file of the version layer above: a lost copy there would leave the stub, and the program would agree with it).
# (`COPY VERSION .git* ...` copies VERSION, the two files .gitattributes / .gitignore and, when the context has a .git folder, the three entries that .dockerignore lets through; it works with and without a .git folder.)
ARG ANTS_BUILD_ID=
COPY docker/resolve_build_id.sh /src/docker/resolve_build_id.sh
COPY VERSION .git* /src/gitinfo/
RUN BUILD_ID="$(sh /src/docker/resolve_build_id.sh "${ANTS_BUILD_ID}" /src/gitinfo)" && \
    cmake -B build "-DANTS_BUILD_ID=${BUILD_ID}" && \
    cmake --build build -j"$(nproc)" --target ants_server && \
    SHOWN="$(/src/build/src/ants_server/ants_server --version)" && \
    echo "${SHOWN}" && \
    case "${SHOWN}" in "ants_server v$(head -n 1 /src/gitinfo/VERSION | tr -d '[:space:]') build "*) ;; *) echo "the server does not say the version of the file VERSION" >&2; exit 1 ;; esac

# =============================================================================
# The runtime image: the program and nothing else, run by an unprivileged user
# =============================================================================
FROM debian:12-slim AS runner

RUN useradd --system --no-create-home --shell /usr/sbin/nologin ants && \
    mkdir -p /maps /results && chown ants /results

# The maps of the original game (the same files as the web game's data)
COPY Original-Ants/Maps/ /maps/

# The players' maps (the .lvl files of Community-Maps/ with the two lists that describe them: GET /maps) in a folder of their own, which the server reads with --community-maps. NOT in /maps: the stack mounts a
# volume there that is filled from the image once and then kept, and a volume (or an ANTS_MAPS_DIR) would hide them, or show an old set after an update. (The previews are the site image's: docker/nginx.conf.)
COPY Community-Maps/*.lvl Community-Maps/*.LVL Community-Maps/maps.json Community-Maps/previews.json /community-maps/

COPY --from=builder /src/build/src/ants_server/ants_server /usr/local/bin/ants_server

USER ants
WORKDIR /results
EXPOSE 4001 4002 4010 4020

# Alive = the game port accepts a connection (bash opens it; the image has no curl). The control interface is not used: it needs the secret.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/4001"]

# Every interface inside the container (a published port does not reach the container's loopback address): the published ports decide who can reach it, see the header
ENTRYPOINT ["/usr/local/bin/ants_server", "--maps", "/maps", "--community-maps", "/community-maps", "--public", "--ws-any-interface", "--ctl-any-interface", "--replay-any-interface", "--submit-any-interface", "--test-map-any-interface", "--results-dir", "/results"]
CMD ["--port", "4001", "--ws-port", "4002", "--ctl-port", "4010"]
