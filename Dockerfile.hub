# =============================================================================
# The chat hub (ants-hub): the global chat service and its login with Discord, Python 3.12 (this image's) and the standard library only (docs/HUB.md).
#   docker build -f Dockerfile.hub -t ants-hub .
#   docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 32 --memory 192m --tmpfs /tmp -v ants-hub-data:/data \
#       -e ANTS_HUB_PUBLIC_URL=https://beta.playants.org ants-hub
# It listens on port 4040 inside the container and is NOT published: the site's nginx reaches it over the network of the stack (wss://<site>/hub/ws and the pages /hub/login, /hub/callback,
# /hub/me, /hub/logout and /hub/forget, docker/nginx.conf). For the login the container needs outbound https to discord.com and to cdn.discordapp.com (the one small picture of a login) and to nothing else.
# /hub/pic/<name>.png serves that picture (docker/nginx.conf).
# The settings are environment variables only: ANTS_HUB_PUBLIC_URL (the site's address; the one Origin a socket may come from), ANTS_HUB_DISCORD_BOT_TOKEN, ANTS_HUB_DISCORD_GUILD, ANTS_HUB_ROLE_ADMIN, ANTS_HUB_ROLE_MOD, ANTS_HUB_ROLE_RECHECK_SECONDS and ANTS_HUB_OWNER (who may moderate: the roles come from the
# site's Discord server),
# ANTS_HUB_DISCORD_CLIENT_ID and ANTS_HUB_DISCORD_CLIENT_SECRET (the Discord application of the login: without both, and the site's address, the chat is read-only for everybody),
# ANTS_HUB_MIN_ACCOUNT_DAYS (how old a Discord account must be to write; 7).
# The database (chat lines kept 7 days, mutes and bans, and the logins: the SHA-256 of a cookie, an account id and a name, 30 days) is /data/hub.db: keep /data in a volume. It is schema 3: a hub of an
# earlier version does not start on it. Moderation: docker exec ants-hub python -m hub.admin list
# No ANTS_BUILD_ID argument on purpose: the image depends on hub/ and nothing else, so a deploy that changes nothing in hub/ builds the same image and the chat is not restarted.
# =============================================================================
# The base image is pinned by tag and digest: the digest is what is pulled, the tag is for the reader and for Dependabot (.github/dependabot.yml), which raises the pair to a newer one in a pull request that CI builds.
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

# /data and /images belong to the user: Docker gives a new, empty named volume the owner of the folder it is mounted on, so the hub can write its
# database and the chat's images there (without it a new volume is root's, and the hub turns images off: images_off_the_folder_cannot_be_written)
RUN useradd --system --no-create-home --shell /usr/sbin/nologin hub && \
    mkdir -p /data /images /app && chown hub /data /images

WORKDIR /app
COPY hub/ /app/hub/
# The bytecode is made now, as root: the image is run read-only, where Python could not write it
RUN python -m compileall -q /app/hub

# Every interface inside the container (the network of the stack reaches it there; nothing is published): the program's own default is the loopback address
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ANTS_HUB_DB=/data/hub.db ANTS_HUB_PORT=4040 ANTS_HUB_HOST=0.0.0.0
USER hub
EXPOSE 4040

# Alive = the hub answers GET /hub/healthz on its own port (the image has no curl)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["python", "-m", "hub.health"]

ENTRYPOINT ["python", "-m", "hub"]
