# Line endings. The text sources, scripts and documents of the project are stored with LF; Git decides for itself which other files are text.
# No file in the repository is renormalised by these rules (do not run `git add --renormalize`): the files that are stored with CRLF
# (the licence text of the bundled font in Original-Ants/, a byte-exact test table) are marked -text below, so their bytes stay exactly
# as they are.
* text=auto

# Scripts: a shell script with CRLF does not run; a batch file for cmd.exe needs CRLF in the working tree (it is stored with LF in the index)
*.sh  text eol=lf
VERSION text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# The original game's folder and byte-exact test data: never touch a byte
Original-Ants/**        -text
Community-Maps/**       -text
tests/data/*.csv        -text
# a byte copy of the licence text beside the game's own font, which the front page serves (tools/front_page_art/make_art.py)
web/front/LibreFranklin-OFL.txt  -text

# Binary files (no end-of-line conversion, no textual diff or merge)
*.chd   binary
*.exe   binary
*.dll   binary
*.mp3   binary
*.MID   binary
*.LVL   binary
*.lvl   binary
*.ttf   binary
*.zip   binary
*.png   binary
*.bmp   binary
*.ico   binary
*.wasm  binary
*.wav   binary

# Hints for the language statistics and diffs of GitHub: vendored or generated files are not the project's own code
include/ants_app/dr_mp3.h           linguist-vendored
asset_catalog/catalog_data.js       linguist-generated
docs/*.json                         linguist-generated
src/ants_sim/*_data.inc             linguist-generated
