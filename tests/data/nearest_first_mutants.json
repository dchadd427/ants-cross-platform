   "old": "nearest_first(targets, sim.get_world_state().ants, tile)",
   "new": "[&] { const auto& wa = sim.get_world_state().ants; std::vector<uint32_t> o = targets; for (size_t i = 0; i < o.size(); i += sim::kMaxCommandAnts) { const size_t e = std::min(o.size(), i + sim::kMaxCommandAnts); std::stable_sort(o.begin() + static_cast<std::ptrdiff_t>(i), o.begin() + static_cast<std::ptrdiff_t>(e), [&](uint32_t x, uint32_t y) { uint32_t kx = 0, ky = 0; for (const auto& a : wa) { if (a.id == x) kx = group_order_distance(a.px, a.py, tile); if (a.id == y) ky = group_order_distance(a.px, a.py, tile); } return kx < ky; }); } return o; }()",
   "build": "test_pointer_model",
