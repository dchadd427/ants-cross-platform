{
 "note": "The private half of tests/data/web_buttons_mutants.json (tools/mutate.py runs it together with the public half): the mutants of files that are not in the public repository, and the ones that only a test that is not there catches. Mutants of the teal buttons' texture (docs: tests/scripts/test_web_buttons.py): the weave, the forced-colors guard, the chosen state, the press, the hover color, the order of a face (an old order makes the declaration invalid), the focus outline, the disabled filter. Run with `python3 tools/mutate.py tests/data/web_buttons_mutants.json --keep-going --jobs 1`; every one must be caught.",
 "mutants": [
  {
   "id": "weave_dropped",
   "file": "web/lobby.html",
   "old": "--sheen: var(--weave), linear-gradient(180deg,",
   "new": "--sheen: linear-gradient(180deg,",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "forced_colors_guard_dropped",
   "file": "web/lobby.html",
   "old": "@media (forced-colors: active) { :root { --weave: linear-gradient(#0000, #0000); --sheen: linear-gradient(#0000, #0000); --btn-text: none; } }",
   "new": "@media (forced-colors: none) { :root { --weave: linear-gradient(#0000, #0000); --sheen: linear-gradient(#0000, #0000); --btn-text: none; } }",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "chosen_state_keeps_the_texture",
   "file": "web/lobby.html",
   "old": ".btn.on { background-image: none; }",
   "new": ".btn.on { background-image: var(--sheen); }",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "press_moves_the_old_way",
   "file": "web/lobby.html",
   "old": ".btn:active:not([disabled]) { transform: translate(3px, 4px);",
   "new": ".btn:active:not([disabled]) { transform: translate(2px, 3px);",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "press_keeps_the_red_shadow",
   "file": "web/matches.css",
   "old": "box-shadow: var(--bevel-dn), 0 0 0 var(--shadow); }",
   "new": "box-shadow: var(--bevel-dn), 1px 1px 0 var(--shadow); }",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "focus_outline_removed",
   "file": "web/lobby.html",
