   "new": ":focus-visible { outline: none; outline-offset: 3px; }",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "a_copy_of_the_frame_differs",
   "file": "web/matches.css",
   "old": "--bevel: inset 0 0 0 1px rgba(255, 255, 255, .38),",
   "new": "--bevel: inset 0 0 0 1px rgba(255, 255, 255, .5),",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "disabled_filter_dropped",
   "file": "web/lobby.html",
   "old": ".btn[disabled] { cursor: default; filter: saturate(.45) brightness(.78); transform: none; }",
   "new": ".btn[disabled] { cursor: default; transform: none; }",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "pill_keeps_the_shadow",
   "file": "web/lobby.html",
   "old": ".btn .pill { text-shadow: none; }",
   "new": ".btn .pill { }",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  },
  {
   "id": "a_disabled_button_is_pressed",
   "file": "web/matches.css",
   "old": ".btn:active:not([disabled]) { transform",
   "new": ".btn:active { transform",
   "test": "python3 -m unittest tests.scripts.test_web_buttons"
  }
 ]
