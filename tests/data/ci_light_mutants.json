   "file": "tools/ci_light.sh",
   "old": "--no-renames --ignore-submodules=none -z",
   "new": "--no-renames -z",
   "test": "python3 tests/scripts/test_ci_light.py",
   "expect": "test_a_bumped_submodule_counts_although_git_is_told_to_ignore_submodules"
  },
