{
 "note": "Mutants of the HUD art's choice of the sheet by the output's scale, of the nine-slice (a long piece: start, repeated run, end) and of the frame's pieces at every shape (src/ants_app/hud_art.cpp, renderer_art.cpp) for tools/mutate.py (docs/TESTING.md, 'Mutation checks'). Run from the checkout: python3 tools/mutate.py tests/data/hud_art_mutants.json --keep-going --jobs 1; every mutant must be caught by the group of test_hud_art named in it.",
 "mutants": [
  {
   "id": "scale_one_to_one_is_not_exact",
   "file": "src/ants_app/hud_art.cpp",
   "old": "if (!(output_scale > 1.0 + 1e-6)) return 1;",
   "new": "if (!(output_scale > 1.5)) return 1;",
   "build": "test_hud_art",
   "test": "./build/tests/test_app/test_hud_art",
   "expect": "[scale]"
  },
  {
   "id": "scale_nearest_below_not_above",
   "file": "src/ants_app/hud_art.cpp",
   "old": "if (!(output_scale > 1.0 + 1e-6)) return 1;",
   "new": "if (output_scale < 1.5) return 1;",
   "build": "test_hud_art",
   "test": "./build/tests/test_app/test_hud_art",
   "expect": "[scale]"
  },
  {
   "id": "scale_two_ends_too_late",
   "file": "src/ants_app/hud_art.cpp",
   "old": "if (output_scale <= 2.0 + 1e-6) return 2;",
   "new": "if (output_scale <= 2.5) return 2;",
   "build": "test_hud_art",
   "test": "./build/tests/test_app/test_hud_art",
   "expect": "[scale]"
  },
  {
   "id": "scale_three_is_never_chosen",
   "file": "src/ants_app/hud_art.cpp",
   "old": "    if (output_scale <= 2.0 + 1e-6) return 2;\n    return 3;",
   "new": "    if (output_scale <= 2.0 + 1e-6) return 2;\n    return 2;",
   "build": "test_hud_art",
   "test": "./build/tests/test_app/test_hud_art",
   "expect": "[scale]"
  },
  {
   "id": "scale_renderer_always_takes_the_first_sheet",
   "file": "src/ants_app/renderer_art.cpp",
   "old": "return hud_art::Art::scale_for(scale);",
   "new": "return 1;",
   "build": "test_hud_art",
   "test": "./build/tests/test_app/test_hud_art",
   "expect": "[scale]"
  },
  {
